# SciAnchor (Research Harness engine) private runtime resources.
#
# Copy this to ~/.config/research-harness/private.env on each machine and keep
# the real file chmod 600. Do not commit real values.

# Scholarly-source contact metadata. Paper search uses no API keys.
OPENALEX_MAILTO=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
PUBMED_EMAIL=

# SPC-only Semantic Scholar throttling (keep in the SPC project .env)
# SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
# SEMANTIC_SCHOLAR_ANON_MIN_INTERVAL_SECONDS=3.6
# SEMANTIC_SCHOLAR_RATE_LIMIT_COOLDOWN_SECONDS=300
# SEMANTIC_SCHOLAR_RECALL_CIRCUIT_BREAKER_SECONDS=600
MINERU_ENABLE=
MINERU_API_TOKEN=
MINERU_BASE_URL=
MINERU_BATCH_SIZE=
MINERU_UPLOAD_CONCURRENCY=
MINERU_DOWNLOAD_CONCURRENCY=
MINERU_POLL_INTERVAL_SECONDS=
MINERU_POLL_TIMEOUT_SECONDS=

# Figure/image providers
FAL_KEY=
GOOGLE_API_KEY=
RESEARCH_HARNESS_FIGURE_MODEL=
RESEARCH_HARNESS_FIGURE_GEMINI_MODEL=
RESEARCH_HARNESS_FIGURE_IMAGE_TIMEOUT_SECONDS=
GROK_API_KEY=
GROK_BASE_URL=
GPT_IMAGE_API_KEY=
GPT_IMAGE_BASE_URL=

# Zotero integration
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=

# Optional direct LLM providers for RH-internal calls.
# Codex itself can still use its own OpenAI-compatible provider config independently.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
