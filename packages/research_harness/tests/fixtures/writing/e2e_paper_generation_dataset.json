    "REBUTTAL_READINESS_GATE_PROFILE",
    "VENUE_OVERLAY"
  ],
  "graders": [
    {
      "name": "artifact_chain_complete",
      "type": "code",
      "pass_condition": "positive cases have every required artifact current; blocker cases name the missing or stale artifact"
    },
    {
      "name": "stage_coverage_complete",
      "type": "code",
      "pass_condition": "positive cases cover the full PW stage order"
    },
    {
      "name": "evidence_bound_claims",
      "type": "code",
      "pass_condition": "claims link to paper IDs, claim IDs, result artifacts, source artifacts, or explicit weak/unsupported markers"
    },
    {
      "name": "domain_route_not_silent_stem",
      "type": "code",
      "pass_condition": "non-STEM cases carry a non-STEM paper profile and domain writing profile"
    },
    {
      "name": "result_claim_boundary",
      "type": "code",
      "pass_condition": "result-backed claims require a result-to-claim profile and allowed claim strength"
    },
    {
      "name": "package_readiness_boundary",
      "type": "code",
      "pass_condition": "package readiness requires source trace, citation integrity, final bundle quality, presubmission severity, and venue constraints"
    },
    {
      "name": "external_action_boundary",
      "type": "code",
      "pass_condition": "no case authorizes network, provider, Zotero, commit, push, PR, release, publication, or third-party write actions"
    }
