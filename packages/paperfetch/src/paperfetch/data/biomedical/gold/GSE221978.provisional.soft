^SERIES = GSE221978
!Series_title = Single-cell RNA sequencing on the vein wall of mouse deep vein thrombosis
!Series_geo_accession = GSE221978
!Series_status = Public on Feb 10 2023
!Series_submission_date = Dec 30 2022
!Series_last_update_date = Feb 11 2023
!Series_pubmed_id = 36721040
!Series_summary = Deep vein thrombosis (DVT) is a common clinical problem, but its cellular and molecular mechanisms remain incompletely understood. We performed single-cell RNA sequencing (scRNA-seq) on the vein wall of mouse inferior vena cava (IVC) ligation model of deep vein thrombosis (DVT), to analyze the transcriptomic changes in the vein wall during acute venous thrombosis.
!Series_overall_design = IVC ligation or sham surgery was performed on 8-week-old male C57BL/6J mice. After 24 hours, mice were euthanized and perfused with PBS, the vein wall was collected and analyzed using scRNAseq.
!Series_sample_id = GSM6911083
!Series_sample_id = GSM6911084
!Series_platform_id = GPL24247
!Series_sample_taxid = 10090
!Series_relation = BioProject: https://www.ncbi.nlm.nih.gov/bioproject/PRJNA916965
^PLATFORM = GPL24247
!Platform_title = Illumina NovaSeq 6000 (Mus musculus)
!Platform_organism = Mus musculus
^SAMPLE = GSM6911083
!Sample_title = SHAM, scRNAseq
!Sample_geo_accession = GSM6911083
!Sample_source_name_ch1 = Inferior vena cava
!Sample_organism_ch1 = Mus musculus
!Sample_characteristics_ch1 = tissue: Inferior vena cava
!Sample_characteristics_ch1 = strain: C57BL/6J
!Sample_characteristics_ch1 = Sex: Male
!Sample_characteristics_ch1 = treatment: Sham surgery
!Sample_extract_protocol_ch1 = Single-cell suspensions from 5 DVT-adjacent IVCs or 8 sham-IVCs were pooled together as one sample.
!Sample_extract_protocol_ch1 = 8000 cells per sample were loaded on a Chromium Controller (10x Genomics). The scRNA-seq libraries were constructed using the Chromium Single Cell 3’ v3.1 Reagent Kit.
!Sample_data_processing = Raw Illumina sequencing reads were aligned to mm10 (GENCODE vM23/Ensembl 98) reference genome and genes were quantified as UMI counts using Cell Ranger Count v6.1.2.
!Sample_data_processing = Assembly: mm10
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_source = transcriptomic single cell
!Sample_library_strategy = RNA-Seq
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6911nnn/GSM6911083/suppl/GSM6911083_sham_filtered_feature_bc_matrix.h5
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6911nnn/GSM6911083/suppl/GSM6911083_sham_raw_feature_bc_matrix.h5
