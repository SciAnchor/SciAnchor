^SERIES = GSE131928
!Series_title = single cell RNA-seq analysis of adult and paediatric IDH-wildtype Glioblastomas
!Series_geo_accession = GSE131928
!Series_status = Public on Jul 07 2019
!Series_submission_date = May 29 2019
!Series_last_update_date = Aug 09 2019
!Series_pubmed_id = 31327527
!Series_summary = To understand the diversity of expression states in IDH-wildtype Glioblastomas, we profiled 24,131 single cells from 28 patients with GBM by single-cell RNA sequencing (7,930 cells by Smartseq2 and 16,201 by 10X).
!Series_overall_design = Tumors were disaggregated, sorted into single cells, and profiled by Smart-seq2 (main text) or 10X (supplementary text).
!Series_overall_design = Authors report that raw data approval was incomplete and only processed data and metadata were attached at submission time.
!Series_sample_id = GSM3828672
!Series_sample_id = GSM3828673
!Series_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE131nnn/GSE131928/suppl/GSE131928_RAW.tar
!Series_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE131nnn/GSE131928/suppl/GSE131928_single_cells_tumor_name_and_adult_or_peidatric.xlsx
!Series_platform_id = GPL18573
!Series_sample_taxid = 9606
