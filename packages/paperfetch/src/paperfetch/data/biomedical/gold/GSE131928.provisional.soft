^PLATFORM = GPL18573
!Platform_title = Illumina NextSeq 500 (Homo sapiens)
!Platform_organism = Homo sapiens
^SAMPLE = GSM3828672
!Sample_title = Smartseq2_GBM_IDHwt
!Sample_geo_accession = GSM3828672
!Sample_source_name_ch1 = Glioblastoma single cell
!Sample_organism_ch1 = Homo sapiens
!Sample_characteristics_ch1 = sample type: single cells
!Sample_extract_protocol_ch1 = Libraries from isolated single cells were generated based on the Smart-seq2 protocol. Libraries from 384 cells with unique barcodes were combined and sequenced using a NextSeq 500 sequencer. For a subset of samples, single cells were processed through the 10X Chromium 3' Single Cell Platform.
!Sample_data_processing = Paired-end reads were mapped to the UCSC hg19 human transcriptome and TPM values were extracted. For the subset processed with 10X, CellRanger was used.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: TPM values for 23,686 genes across 7,930 glioma cells processed with Smartseq2 or 30,401 genes across 16,201 glioma cells with the 10X platform.
!Sample_instrument_model = Illumina NextSeq 500
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
