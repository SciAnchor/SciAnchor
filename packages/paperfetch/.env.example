# =================================================================
# paperfetch 环境变量模板
#
# 复制到 ~/.config/spc/secrets.env（默认自动加载），或用 --env-file <path> 显式指定。
# 仓库根的 .env 不会被自动加载。所有 Key 都是可选的：不配置时 SPC 使用匿名/公开通道，
# 只是限流更严格。完整字段、默认值与密级见 `spc schema config`。
# 未在 schema 中注册的 SPC_* 变量会让 doctor / system preflight 失败。
# =================================================================

# development = 源码检出（pip install -e .）；production = 已安装的 release wheel
SPC_ENVIRONMENT=development

# 运行状态、缓存与数据目录（留空使用 ~/.spc/{state,cache,data}）
SPC_STATE_ROOT=
SPC_CACHE_ROOT=
SPC_DATA_ROOT=


# ----------------- 1. 学术元数据 API（全部可选） -----------------
# OpenAlex：多 Key 用逗号分隔写入 OPENALEX_API_KEYS。
OPENALEX_API_KEY=
OPENALEX_API_KEYS=
# Crossref / OpenAlex polite pool 联系邮箱
OPENALEX_MAILTO=
CROSSREF_MAILTO=
OPENALEX_MIN_INTERVAL_SECONDS=0.2
OPENALEX_RATE_LIMIT_COOLDOWN_SECONDS=300

# Semantic Scholar：多个真实不同的 Key 用逗号分隔。
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_KEYS=
# 官方初始 Key 通常约 1 request/second；无 Key 走共享匿名池，更容易 429。
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
SEMANTIC_SCHOLAR_ANON_MIN_INTERVAL_SECONDS=3.6
SEMANTIC_SCHOLAR_RATE_LIMIT_COOLDOWN_SECONDS=300

# Unpaywall 要求的联系邮箱（用于 DOI 的 OA 位置查询）
UNPAYWALL_EMAIL=

# NCBI E-utilities（PubMed、NCBI 数据集）
NCBI_API_KEY=
NCBI_EMAIL=

# 出版社官方 API（只用于你的 Key 有权访问的内容）
ELSEVIER_API_KEY=
SPRINGER_API_KEY=

# Sciverse 语义检索（`spc paper sciverse`，可选）
SCIVERSE_API_TOKEN=

# Dryad API（可选，提升限额）
DRYAD_API_TOKEN=

# GitHub Token（可选，代码可用性检查时避免匿名限流）
GITHUB_TOKEN=


# ----------------- 2. MinerU PDF 解析 -----------------
# 不配置时 `paper download` 仍会获取并验证 PDF，解析阶段返回 partial。
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net


# ----------------- 3. 大语言模型（可选，任意 OpenAI-compatible 端点） -----------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# 同时配置多个 provider 时，用 LLM_PROVIDER 显式选择（generic|gpt|openrouter|qwen）
LLM_PROVIDER=


# ----------------- 4. 网络代理（全部可选，互不复用） -----------------
# 留空即直连。SPC 不读取系统 ambient proxy。
METADATA_PROXY=
DOWNLOAD_PROXY=
MINERU_PROXY=
# 公开数据归档：direct 或 proxy
ARCHIVE_PROXY_MODE=direct
ARCHIVE_PROXY=
# GEO 大文件下载可单独指定代理
SPC_GEO_PROXY=

# 全局 PDF 缓存目录
PDF_CACHE_ROOT=.spc_cache/pdf


# ----------------- 5. 日志 -----------------
SPC_LOG_MODE=development
SPC_LOG_LEVEL=INFO
SPC_LOG_FILE=
SPC_EVENT_FILE=
